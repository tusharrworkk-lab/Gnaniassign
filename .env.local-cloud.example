# Copy to .env.local-cloud. This file is ignored so keys/passwords stay local.
POSTGRES_PASSWORD=change-this-to-a-long-random-password
LOCAL_CLOUD_API_PORT=8080

# Use hosted services: the small local-cloud host does not run large models.
LLM_PROVIDER=bedrock_gpt_oss
BEDROCK_REGION=ap-south-1
BEDROCK_AUTH_MODE=iam
BEDROCK_GPT_OSS_MODEL=openai.gpt-oss-120b-1:0
BEDROCK_GPT_OSS_MAX_OUTPUT_TOKENS=256
BEDROCK_GPT_OSS_TEMPERATURE=0.2
BEDROCK_GPT_OSS_REASONING_EFFORT=low

STT_PROVIDER=gnani
TTS_PROVIDER=gnani
GNANI_API_KEY=
GNANI_STT_LANGUAGE=en-IN
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_TTS_LANGUAGE=hi-en
GNANI_TTS_SPEED=1.0

# Keep heavy local classifiers disabled. Enable shadow classification only after
# you have measured memory/latency and have a reviewed-label workflow.
INTENT_PROVIDER=generic
RETAIL_MINILM_ENABLED=false
SHADOW_INTENT_ENABLED=false

EPISODIC_MEMORY_PROVIDER=postgres
KNOWLEDGE_BASE_ENABLED=true
KNOWLEDGE_BASE_PROVIDER=postgres
ORDER_DATA_ENABLED=true
ORDER_CONTEXT_PROVIDER=postgres
CONVERSATION_LOGGING_ENABLED=true
CONVERSATION_JUDGE_ENABLED=false

PROMPT_TREE_ENABLED=true
PROMPT_CACHE_PROVIDER=redis
PROMPT_PLAN_CACHE_TTL_SECONDS=300
TENANT_ID=default
AGENT_CHANNEL=voice
AGENT_LANGUAGE=hinglish

# Use non-empty development secrets even locally, then send the matching API
# key/signature in curl or your telephony adapter.
AGENT_API_KEY=replace-with-a-long-random-local-api-key
WEBHOOK_SIGNING_SECRET=replace-with-a-long-random-local-webhook-secret
VOICELINK_WS_TOKEN=replace-with-a-long-random-telephony-websocket-token
DASHBOARD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
