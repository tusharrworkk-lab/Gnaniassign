AI_GATEWAY_API_KEY=
INTENT_PROVIDER=local_laya
RETAIL_INTENT_MODEL=Hari5115/hinglish-retail-intent-classifier
RETAIL_INTENT_DEVICE=cuda
RETAIL_INTENT_MAX_LENGTH=128
# The published retail model is not calibrated to a 0.5 probability cutoff.
RETAIL_INTENT_THRESHOLD=0.12
# Locally trained nine-label MiniLM dual encoder. Set INTENT_PROVIDER=retail_minilm.
# Set false to bypass every intent classifier and use one general support agent.
RETAIL_MINILM_ENABLED=true
RETAIL_MINILM_MODEL=artifacts/models/systemone-retail-v1
RETAIL_MINILM_DEVICE=auto
RETAIL_MINILM_MAX_LENGTH=64
# This score is not calibrated on real customer traffic; tune against a real holdout.
RETAIL_MINILM_THRESHOLD=0.60
# Set both variables to persist customer turns in PostgreSQL. Pass an authenticated
# caller/account ID to create_session(customer_id=...) in production; the fixed
# ID below is appropriate only for the supplied mock-memory test.
EPISODIC_MEMORY_DATABASE_URL=
EPISODIC_MEMORY_CUSTOMER_ID=
EPISODIC_MEMORY_PROVIDER=postgres
# Opt-in full conversation review ledger. It stores transcripts, so set a
# retention/deletion policy before using real customer data.
CONVERSATION_LOGGING_ENABLED=false
CONVERSATION_LOG_DATABASE_URL=
# Judge the full STT/LLM transcript only when a microphone call ends. It is
# intentionally off by default because it sends full transcripts to Bedrock.
CONVERSATION_JUDGE_ENABLED=false
CONVERSATION_JUDGE_MAX_TOKENS=1000
# Optional ACIL/Alan trace delivery. Use a scoped key; never copy ACIL's own
# workspace key into source control.
ACIL_TRACE_ENABLED=false
ACIL_TRACE_URL=http://127.0.0.1:8000
ACIL_TRACE_PROJECT_ID=
ACIL_TRACE_API_KEY=
# PostgreSQL approved knowledge chunks, scoped to the routed intent.
KNOWLEDGE_BASE_ENABLED=false
KNOWLEDGE_BASE_DATABASE_URL=
KNOWLEDGE_BASE_PROVIDER=postgres
# Optional verified customer-order records. For local testing, apply
# infra/postgres/customer_orders.sql and infra/postgres/mock_customer_orders.sql.
ORDER_DATA_ENABLED=false
ORDER_DATA_DATABASE_URL=
ORDER_CONTEXT_PROVIDER=postgres
# Versioned tenant prompt tree. PostgreSQL remains authoritative; the local
# process cache is the hot path and Redis is an optional shared L2 cache.
TENANT_ID=default
AGENT_CHANNEL=voice
AGENT_LANGUAGE=hinglish
PROMPT_TREE_ENABLED=false
PROMPT_TREE_DATABASE_URL=
PROMPT_PLAN_CACHE_TTL_SECONDS=300
PROMPT_CACHE_PROVIDER=none
REDIS_URL=
# Work-management integrations. Plane mutations never go directly from the
# phone agent to Plane: they are drafts in PostgreSQL until owner approval.
WORK_ACTION_DATABASE_URL=
# Local owner key for approval rows. Later this becomes the authenticated
# dashboard user/tenant ID; callers never supply it.
WORK_ACTION_OWNER_ID=owner
PLANE_API_BASE_URL=https://api.plane.so
PLANE_WORKSPACE_SLUG=
PLANE_API_KEY=
# Read one explicitly requested item during a voice call only when the inbound
# caller ID (last 10 digits) matches this comma-separated allowlist.
PLANE_VOICE_STATUS_ENABLED=false
PLANE_VOICE_TRUSTED_CALLERS=
# Google Calendar OAuth. Create the OAuth client in Google Cloud Console, keep
# both secrets only on the server, then use /connect from the dashboard.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_DATABASE_URL=
GOOGLE_CALENDAR_OWNER_ID=tushar
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://voice.sidecut.me/v1/integrations/google-calendar/callback
# Generate once with: uv run --extra google-calendar python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
# Separate random secret for signed, 10-minute OAuth CSRF state values.
GOOGLE_CALENDAR_STATE_SECRET=
GOOGLE_CALENDAR_REFRESH_SECONDS=60
# HTTP/Webhook API. Keep both secrets outside source control. In production the
# server refuses unauthenticated API/webhook traffic.
AGENT_ENVIRONMENT=development
AGENT_API_KEY=
WEBHOOK_SIGNING_SECRET=
VOICELINK_WS_TOKEN=
# Optional ONNX CPU acoustic endpoint detector for VoiceLink calls.
# Start with shadow, compare boundary telemetry, then use endpoint mode.
VOICE_LINK_SILERO_VAD_MODE=off
VOICE_LINK_SILERO_VAD_THRESHOLD=0.55
VOICE_LINK_SILERO_VAD_MIN_SILENCE_MS=350
VOICE_LINK_VAD_ENDPOINT_GRACE_MS=250
# Provider-final results receive only this short continuation grace when
# endpoint VAD is off. This avoids the legacy 1.1 s turn-coalescing delay.
VOICELINK_PROVIDER_FINAL_GRACE_MS=250
VOICE_LINK_TTS_FIRST_FRAGMENT_CHARS=42
VOICE_LINK_TTS_FRAGMENT_CHARS=90
# Preferred endpoint stack for telephone calls. The acoustic layer runs on
# every short frame; Smart Turn v3 sees only a completed-pause candidate.
VOICE_LINK_TURN_DETECTION_MODE=off
VOICE_LINK_TURN_DETECTOR=ten_pipecat
VOICE_LINK_TEN_VAD_THRESHOLD=0.5
VOICE_LINK_TEN_VAD_HOP_SAMPLES=256
VOICE_LINK_TEN_VAD_MIN_SPEECH_MS=160
VOICE_LINK_TEN_VAD_MIN_SILENCE_MS=320
# Inbound-only telephone audio cleanup. Start with shadow to compare WebRTC
# APM metrics without changing STT audio; use enabled after review.
VOICE_LINK_AUDIO_ENHANCEMENT=off
VOICE_LINK_NS_BACKEND=webrtc_apm
# WebRTC NS level: 0=light, 1=moderate, 2=strong, 3=very strong.
VOICE_LINK_NS_LEVEL=1
# Comma-separated browser origins permitted to call the dashboard API. In
# production prefer a same-origin authenticated dashboard proxy.
DASHBOARD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Run the trained MiniLM only in the background while the generic agent remains
# customer-facing. Predictions require human review before they become training labels.
SHADOW_INTENT_ENABLED=false
INTENT_FEEDBACK_DATABASE_URL=
# Offline MiniLM review: classify stored completed turns at night, then send
# candidate labels to a private Telegram review channel. Never put these in Git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_REVIEW_CHAT_ID=
TELEGRAM_REVIEW_MAX_ITEMS=20
LAYA_GATEWAY_URL=https://ai-gateway.vercel.sh/typesafe/v1/systemone
LAYA_MODEL=convaiinnovations/laya
# Persistent native server, used with INTENT_PROVIDER=laya_cpp
LAYA_CPP_URL=http://127.0.0.1:8080
LAYA_CPP_MODEL=laya
LAYA_CPP_API_KEY=
LAYA_CPP_TIMEOUT_SECONDS=5
# Private AWS Lambda laya.cpp router. The caller needs lambda:InvokeFunction
# permission; no public Function URL or API Gateway is used.
LAYA_LAMBDA_FUNCTION=gnani-laya-multilingual
LAYA_LAMBDA_REGION=ap-south-1
LAYA_LAMBDA_TIMEOUT_SECONDS=15
GNANI_API_KEY=
# Realtime speech adapters. Add a provider to voice/providers.py; the
# microphone and playback pipeline then stay unchanged.
STT_PROVIDER=gnani
TTS_PROVIDER=gnani
# Gnani's 16 kHz wideband pipeline: PCM S16LE mono, exactly 1,024 bytes / 32 ms.
GNANI_STT_LANGUAGE=en-IN
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_SAMPLE_RATE=16000
GNANI_STT_FORMAT=verbatim
# A shorter silence window emits final segments sooner but can split pauses.
GNANI_VAD_THRESHOLD=0.55
GNANI_MIN_SILENCE_MS=400
VOICE_LINK_STT_MIN_SILENCE_MS=400
GNANI_MIN_SPEECH_MS=50
GNANI_MIN_SEGMENT_MS=100
# Gnani Timbre v3 realtime TTS. Raw PCM is streamed directly to playback.
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_TTS_LANGUAGE=hi-en
GNANI_TTS_SPEED=1.0
# Timbre v3 only. The app strips arbitrary LLM tags. The two optional latency
# cues below are application rules, not model-generated markup.
GNANI_TTS_AUDIO_TAGS=false
GNANI_TTS_LATENCY_GIGGLE_ENABLED=true
GNANI_TTS_LATENCY_GIGGLE_MS=450
# Optional post-response cue. Enable only when a separate latency cue is desired.
GNANI_TTS_POST_RESPONSE_CLEAR_THROAT_ENABLED=false
GNANI_TTS_POST_RESPONSE_CLEAR_THROAT_MS=600
GNANI_TTS_SAMPLE_RATE=24000
# JSONL latency records (no audio or transcript text) written once per completed voice turn.
VOICE_METRICS_LOG=artifacts/voice-latency.jsonl
# Opt-in LangSmith traces include LLM prompt/context and model output. Keep the
# key only in .env, never in source control.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gnani-voice-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LOCAL_LAYA_MODEL=convaiinnovations/laya
LOCAL_LAYA_DEVICE=cuda
LOCAL_LAYA_BACKEND=eager
SUBAGENT_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
SUBAGENT_MODEL=meta/llama-3.1-8b
# Use bedrock for the existing generic Bedrock adapter, or bedrock_gpt_oss for
# the separate GPT-OSS adapter below.
LLM_PROVIDER=vercel
# Amazon Bedrock: direct in-region invocation, pinned to Mumbai (not an APAC profile).
BEDROCK_REGION=ap-south-1
# Example direct Bedrock model ID. Ensure your account/region has access.
BEDROCK_MODEL=openai.gpt-oss-120b-1:0
BEDROCK_MAX_OUTPUT_TOKENS=32
BEDROCK_TEMPERATURE=0.5
# api_key uses BEDROCK_API_KEY; iam uses AWS_PROFILE, an IAM role, or standard
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY credentials.
BEDROCK_AUTH_MODE=api_key
# Paste a Bedrock API key here. The SDK sends it as AWS_BEARER_TOKEN_BEDROCK.
BEDROCK_API_KEY=
# GPT-OSS uses a separate adapter because its reasoning blocks and token budget
# differ from the existing Bedrock/Gemma path.
BEDROCK_GPT_OSS_MODEL=openai.gpt-oss-120b-1:0
BEDROCK_GPT_OSS_MAX_OUTPUT_TOKENS=256
BEDROCK_GPT_OSS_TEMPERATURE=0.2
BEDROCK_GPT_OSS_REASONING_EFFORT=low
# Alternatively use the normal AWS SDK credential chain: AWS_PROFILE, SSO, or an IAM role.
AWS_PROFILE=
# Simplismart shared endpoint: Llama 3.1 8B. Set LLM_PROVIDER=simplismart to activate it.
SIMPLISMART_API_KEY=
SIMPLISMART_BASE_URL=https://api.simplismart.live
SIMPLISMART_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
SIMPLISMART_MAX_OUTPUT_TOKENS=32
SIMPLISMART_TIMEOUT_SECONDS=20
# Cerebras Llama 3.3 70B. Set LLM_PROVIDER=cerebras to activate it.
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-3.3-70b
CEREBRAS_MAX_OUTPUT_TOKENS=32
# Disable Qwen reasoning for short, latency-sensitive voice turns.
CEREBRAS_REASONING_EFFORT=none
CEREBRAS_TIMEOUT_SECONDS=20
# Groq Llama 3.3 70B. Set LLM_PROVIDER=groq to activate it.
# Groq's public API currently has no customer-selectable India endpoint.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_OUTPUT_TOKENS=32
# GPT-OSS supports low, medium, or high; low is the minimum-latency setting.
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT_SECONDS=20
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_GEMMA_MODEL=google/gemma-3-1b-it
VLLM_API_KEY=local-gemma
VLLM_TIMEOUT_SECONDS=10
# Gemini 2.5 Flash on Vertex AI. Keep LLM_PROVIDER=vercel until credentials are set.
# vertex_api_key is Vertex AI Express Mode. vertex_adc is the regional Vertex AI route.
GEMINI_AUTH_MODE=vertex_api_key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Disable Gemini 2.5 Flash thinking for latency-sensitive short voice turns.
GEMINI_THINKING_BUDGET=0
# Gemini 3.5 Flash-Lite: explicit lowest-latency thinking mode.
GEMINI_THINKING_LEVEL=MINIMAL
# Keep spoken answers short; raise only when a longer response is genuinely needed.
GEMINI_MAX_OUTPUT_TOKENS=32
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1
INTENT_THRESHOLD=0.5
