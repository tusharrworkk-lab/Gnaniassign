AI_GATEWAY_API_KEY=
INTENT_PROVIDER=local_laya
RETAIL_INTENT_MODEL=Hari5115/hinglish-retail-intent-classifier
RETAIL_INTENT_DEVICE=cuda
RETAIL_INTENT_MAX_LENGTH=128
# The published retail model is not calibrated to a 0.5 probability cutoff.
RETAIL_INTENT_THRESHOLD=0.12
LAYA_GATEWAY_URL=https://ai-gateway.vercel.sh/typesafe/v1/systemone
LAYA_MODEL=convaiinnovations/laya
# Persistent native server, used with INTENT_PROVIDER=laya_cpp
LAYA_CPP_URL=http://127.0.0.1:8080
LAYA_CPP_MODEL=laya
LAYA_CPP_API_KEY=
LAYA_CPP_TIMEOUT_SECONDS=5
# Private AWS Lambda laya.cpp router. The caller needs lambda:InvokeFunction
# permission; no public Function URL or API Gateway is used.
LAYA_LAMBDA_FUNCTION=gnani-laya-multilingual
LAYA_LAMBDA_REGION=ap-south-1
LAYA_LAMBDA_TIMEOUT_SECONDS=15
GNANI_API_KEY=
# Gnani's 16 kHz wideband pipeline: PCM S16LE mono, exactly 1,024 bytes / 32 ms.
GNANI_STT_LANGUAGE=en-IN
GNANI_STT_SAMPLE_RATE=16000
GNANI_STT_FORMAT=verbatim
# Fastest final-segment configuration. It can split natural mid-sentence pauses.
GNANI_VAD_THRESHOLD=0.55
GNANI_MIN_SILENCE_MS=150
GNANI_MIN_SPEECH_MS=50
GNANI_MIN_SEGMENT_MS=100
# Gnani Timbre v3 realtime TTS. Raw PCM is streamed directly to playback.
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_TTS_LANGUAGE=hi-en
GNANI_TTS_SPEED=1.0
GNANI_TTS_SAMPLE_RATE=24000
# JSONL latency records (no audio or transcript text) written once per completed voice turn.
VOICE_METRICS_LOG=artifacts/voice-latency.jsonl
# Opt-in LangSmith traces include LLM prompt/context and model output. Keep the
# key only in .env, never in source control.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gnani-voice-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LOCAL_LAYA_MODEL=convaiinnovations/laya
LOCAL_LAYA_DEVICE=cuda
LOCAL_LAYA_BACKEND=eager
SUBAGENT_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
SUBAGENT_MODEL=meta/llama-3.1-8b
# Use bedrock for Gemma 3 4B in the Mumbai Bedrock region.
LLM_PROVIDER=vercel
# Amazon Bedrock: direct in-region invocation, pinned to Mumbai (not an APAC profile).
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL=google.gemma-3-4b-it
BEDROCK_MAX_OUTPUT_TOKENS=32
BEDROCK_TEMPERATURE=0.5
# api_key uses BEDROCK_API_KEY; iam uses AWS_PROFILE, an IAM role, or standard
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY credentials.
BEDROCK_AUTH_MODE=api_key
# Paste a Bedrock API key here. The SDK sends it as AWS_BEARER_TOKEN_BEDROCK.
BEDROCK_API_KEY=
# Alternatively use the normal AWS SDK credential chain: AWS_PROFILE, SSO, or an IAM role.
AWS_PROFILE=
# Simplismart shared endpoint: Llama 3.1 8B. Set LLM_PROVIDER=simplismart to activate it.
SIMPLISMART_API_KEY=
SIMPLISMART_BASE_URL=https://api.simplismart.live
SIMPLISMART_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
SIMPLISMART_MAX_OUTPUT_TOKENS=32
SIMPLISMART_TIMEOUT_SECONDS=20
# Cerebras Llama 3.3 70B. Set LLM_PROVIDER=cerebras to activate it.
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-3.3-70b
CEREBRAS_MAX_OUTPUT_TOKENS=32
# Disable Qwen reasoning for short, latency-sensitive voice turns.
CEREBRAS_REASONING_EFFORT=none
CEREBRAS_TIMEOUT_SECONDS=20
# Groq Llama 3.3 70B. Set LLM_PROVIDER=groq to activate it.
# Groq's public API currently has no customer-selectable India endpoint.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_OUTPUT_TOKENS=32
# GPT-OSS supports low, medium, or high; low is the minimum-latency setting.
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT_SECONDS=20
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_GEMMA_MODEL=google/gemma-3-1b-it
VLLM_API_KEY=local-gemma
VLLM_TIMEOUT_SECONDS=10
# Gemini 2.5 Flash on Vertex AI. Keep LLM_PROVIDER=vercel until credentials are set.
# vertex_api_key is Vertex AI Express Mode. vertex_adc is the regional Vertex AI route.
GEMINI_AUTH_MODE=vertex_api_key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Disable Gemini 2.5 Flash thinking for latency-sensitive short voice turns.
GEMINI_THINKING_BUDGET=0
# Gemini 3.5 Flash-Lite: explicit lowest-latency thinking mode.
GEMINI_THINKING_LEVEL=MINIMAL
# Keep spoken answers short; raise only when a longer response is genuinely needed.
GEMINI_MAX_OUTPUT_TOKENS=32
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1
INTENT_THRESHOLD=0.5
